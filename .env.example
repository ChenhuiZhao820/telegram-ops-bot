# --- Telegram ---
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# Random secret used to validate webhook calls (see README / design doc Section 9)
TELEGRAM_WEBHOOK_SECRET=replace-with-random-hex
# Comma-separated numeric Telegram user IDs allowed to use the bot (both founders)
ALLOWED_TELEGRAM_USER_IDS=111111111,222222222

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-your-key
# Model used by the orchestrator loop
ANTHROPIC_MODEL=claude-sonnet-4-6
# Max Claude tool-use round trips per task
MAX_TOOL_ITERATIONS=15
# Safety net: chat context older than this is dropped even if the session was
# never explicitly closed (sessions normally end via the close_session tool)
CONTEXT_TTL_HOURS=48

# --- Airtable ---
# Personal access token with data.records:read/write + schema.bases:read on both bases
AIRTABLE_API_KEY=pat-your-token
# Comma-separated base IDs: Basanite XRM first, Basanite Todos second
AIRTABLE_BASE_IDS=appXRMxxxxxxxxxxx,appTODOxxxxxxxxxx

# --- Devin ---
# v3 service-user key (cog_...) and the organization ID (org-...)
DEVIN_API_KEY=your-devin-api-key
DEVIN_ORG_ID=org-your-org-id
# How often the worker polls active Devin sessions to push state changes
# (halts, questions, finishes) to the founder's chat
DEVIN_WATCH_INTERVAL_S=10

# --- Otter (optional; leave blank to stub the Otter adapter) ---
# Obtained via scripts/otter_auth.py (one-time browser OAuth on your laptop)
OTTER_ACCESS_TOKEN=
OTTER_REFRESH_TOKEN=
# OAuth token endpoint + client id, printed by scripts/otter_auth.py, needed only for refresh
OTTER_TOKEN_URL=
OTTER_CLIENT_ID=
# Otter MCP server URL (confirm from Otter's help center)
OTTER_MCP_URL=https://mcp.otter.ai/mcp

# --- Database ---
# On Render this is injected from the managed Postgres. For local dev either
# point at a local Postgres or use SQLite (zero setup):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/intern
DATABASE_URL=sqlite:///intern.db
